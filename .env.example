# --- VPN rotation (optional but recommended) ---
# Path to OpenVPN GUI exe. Default install location:
OPENVPN_GUI=C:\Program Files\OpenVPN\bin\openvpn-gui.exe

# Folder containing your Proton .ovpn configs. OpenVPN GUI defaults to:
OPENVPN_CONFIG_DIR=C:\Users\aryan\OpenVPN\config

# Optional: explicit subset of .ovpn files to rotate through.
# Comma-separated filenames (no path). If blank, uses every .ovpn in the dir.
# OVPN_FILES=us-ny.protonvpn.udp.ovpn,uk-lon.protonvpn.udp.ovpn,de-fra.protonvpn.udp.ovpn

# Rotate proactively every N hashtags. 0 = reactive only. 5 = good default.
PROACTIVE_ROTATION_EVERY=5
