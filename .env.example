# TikTok session token. Get from tiktok.com cookies after logging in.
# 1. Open tiktok.com in Chrome, log in
# 2. F12 -> Application -> Cookies -> https://www.tiktok.com
# 3. Copy the value of the "msToken" cookie
# Supports multiple tokens separated by commas (scraper auto-rotates).
MS_TOKEN=paste_your_ms_token_here

# --- Residential proxy (IPRoyal Royal Residential recommended) ---
# Sign up at iproyal.com -> Royal Residential -> $7 starter, then scale.
# Dashboard -> Proxy List gives you an endpoint like geo.iproyal.com:12321
# and a username template with embedded options.
#
# Use country-us for US creators, session-<anything> for sticky IPs,
# lifetime-30m for 30-minute IP holds (so a browser session doesn't break mid-scrape).
PROXY_SERVER=http://geo.iproyal.com:12321
PROXY_USER=your_iproyal_username_country-us_session-base_lifetime-30m
PROXY_PASS=your_iproyal_password

# --- Tuning (all optional, sensible defaults in code) ---
# NUM_SESSIONS=6               # parallel browsers. M4 Pro 24GB handles 6-8.
# VIDEOS_PER_HASHTAG=500       # 500 gives best unique-creator-per-minute ratio
# HASHTAGS_PER_BROWSER=10      # recycle browser after N hashtags
# ENRICH_NUM_SESSIONS=6
# CREATORS_PER_BROWSER=25
# FOLLOWER_MIN=10000           # enrichment prefilter lower bound
# FOLLOWER_MAX=2000000         # enrichment prefilter upper bound
# TIKTOK_BROWSER=chromium      # or firefox / webkit

# --- Optional phone notifications via ntfy.sh ---
# 1. Install ntfy app, pick any topic name, subscribe
# 2. Uncomment and set NTFY_TOPIC below
# NTFY_TOPIC=your-topic-name

# --- Token auto-refresh (run token_refresher.py in a separate terminal) ---
# TOKEN_REFRESH_INTERVAL_MIN=30
